@startuml Basic Sample
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
title
 <u>Context diagram</u> TO BE for Smart Home Application in common
end title

Person(user, "Клиент")



Boundary(sm, "Smart Home") {
    Person(impl, "Внедренец")
    Person(manager, "Менеджер") 
    Person(dev, "Член команды разработки")
    Person(accountant, "Бухгалтер") 
    Person(clvl, "Управляющий, ЛПР, Выгодоприобретатель")

    System_Boundary(sm_bound, "Smart home Application") {
        System(main_app, "SmartHome ", "Основное приложение", "", "React, C#, PostgreSQL")
    }
    System_Ext(sensor, "Датчик, совместимый с приложением")
    System_Ext(actuator, "Актуатор, совместимый с приложением")
}

'##########
'  КЛИЕНТ  
'##########
Rel_D(user, main_app, "<<Uses>>", "1. Регистрируется, аутентифицируется и авторизуется в приложении")
Rel_D(user, main_app, "<<Uses>>", "2. Управляет (CUD операции) Обьектами, Локациями, Датчиками, Актуаторами")
Rel_D(user, main_app, "<<Uses>>", "3. Получает информацию о состоянии (в широком смысле) своих Объектов (в широком смысле) в момент времени")
Rel_D(user, main_app, "<<Uses>>", "4. Получает информацию о состоянии своих Объектов, Сценариев автоматизации в прошлом на произвольную глубину")
Rel_D(user, main_app, "<<Uses>>", "5. Управляет (СUD) Сценариями автоматизации деятельности Актуаторов")
Rel_D(user, main_app, "<<Uses>>", "6. Получает помощь в приложении от Менеджеров //не сказано напрямую в требованиях//")
Rel_D(user, main_app, "<<Uses>>", "7. Управляет заявками на проведение работ с привлечением Внедренцев")
Rel_D(user, main_app, "<<Uses>>", "8. Оплачивает возможность использования приложения")


Rel_D(user, sensor, "Покупает")
Rel_D(user, sensor, "Подключает к приложению")
Rel_D(user, actuator, "Покупает")
Rel_D(user, actuator, "Подключает к приложению")

Rel(user, manager, "Общается вне приложения")

'##########
'  ВНЕДРЕНЕЦ  
'##########
Rel_U(impl, main_app, "<<Uses>>", "1. Регистрируется, аутентифицируется и авторизуется в приложении")
Rel_U(impl, main_app, "<<Uses>>", "2. Участвует в выполнении заявок от Менеджеров и Пользователей")
Rel_U(impl, main_app, "<<Uses>>", "3. Получает информацию о состоянии (в широком смысле) сопровождаемых Объектов (в широком смысле) в момент времени")
Rel_U(impl, main_app, "<<Uses>>", "4. Получает информацию о состоянии сопровождаемых Объектов, Сценариев автоматизации в прошлом на ограниченную глубину")


Rel_U(impl, sensor, "Подключает к приложению")
Rel_U(impl, actuator, "Подключает к приложению")
Rel_U(impl, sensor, "Обслуживает")
Rel_U(impl, actuator, "Обслуживает")

Rel(impl, user, "Общается вне приложения при первичной настройке приложения")
Rel(impl, manager, "Общается вне приложения ")

'##########
'  МЕНЕДЖЕР  
'##########
Rel_L(manager, main_app, "<<Uses>>", "1. Регистрируется, аутентифицируется и авторизуется в приложении")
Rel_L(manager, main_app, "<<Uses>>", "2. Участвует в выполнении заявок от Пользователей")
Rel_L(manager, main_app, "<<Uses>>", "3. Создает заявки для Менеджеров")
Rel_L(manager, main_app, "<<Uses>>", "4. Получает агрегированную информацию об Объектах, Пользователях")
Rel_L(manager, main_app, "<<Uses>>", "5. Проводит маркетинговые меропрятия (рассылки, конкурсы и т.п.)")

Rel(manager, clvl, "Предоставляет отчеты приложения о работе бизнеса")
Rel(manager, account, "Предоставляет отчеты приложения о работе бизнеса")


'##########
'  Dev-man  
'##########
Rel_L(dev, main_app, "<<Uses>>", "1. Проектирует, разрабатывает, тестирует, деплоит")
Rel(dev, manager, "Консультирует")
Rel(dev, impl, "Консультирует")



'##########
'  БУХГАЛТЕР, C-Level  
'##########
Rel(clvl, manager, "Управляет")
Rel(clvl, impl, "Управляет")
Rel(clvl, dev, "Управляет")


'##########
'  Датчик  
'##########
Rel(sensor, main_app, "Регистриуется в")
Rel(sensor, main_app, "Отправляет даныне в")

'##########
'  Актуатор  
'##########
Rel(actuator, main_app, "Регистриуется в")
Rel(actuator, main_app, "Отправляет даныне в")

'##########
'  ПРИЛОЖЕНИЕ  
'##########
Rel(main_app, user, "Информирует о нештатных ситуациях")
Rel(main_app, impl, "Информирует о нештатных ситуациях")
Rel(main_app, actuator, "Управляет")
Rel(main_app, sensor, "Управляет")
Rel(main_app, dev, "Предоставляет максимально подробную телеметрию своей работы")




@enduml